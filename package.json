{
  "name": "prellusion-api",
  "version": "1.0.0",
  "description": "api for prellusion-ui",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "start": "nodemon --watch src --exec 'node --loader ts-node/esm' src/server.ts",
    "migrate": "npx sequelize-cli db:migrate",
    "undo": "npx sequelize-cli db:migrate:undo",
    "build": "tsc",
    "deleteDb": "npx sequelize-cli db:migrate:undo:all",
    "resetDb": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate",
    "pubSubEmulators": "node --loader ts-node/esm scripts/test-subscriber.ts",
    "dropDb": "dropdb -U postgres prellusion && createdb -U postgres prellusion && npm run migrate"
  },
  "author": "EmmVega",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@google-cloud/pubsub": "^5.1.0",
    "@graphql-tools/graphql-file-loader": "^8.0.1",
    "@graphql-tools/load": "^8.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "class-validator-jsonschema": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.0",
    "graphql-upload": "^17.0.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.29.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.1",
    "routing-controllers": "^0.10.4",
    "routing-controllers-openapi": "^4.0.0",
    "ruru": "^2.0.0-beta.11",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7",
    "swagger-ui-dist": "^5.10.5",
    "uninstall": "^0.0.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/register": "^7.27.1",
    "@jest/globals": "^30.0.5",
    "@types/graphql-upload": "^17.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^30.0.5",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^5.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
