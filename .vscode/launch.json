{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Debug TypeScript",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/node_modules/ts-node/dist/bin.js",
            "runtimeArgs": [
                "--loader",
                "ts-node/esm"
            ],
            "args": [
                "${workspaceFolder}/src/server.ts"
            ],
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${workspaceFolder}/src/*"
            },
            "env": {
                "NODE_ENV": "test",
                "OPENAI_API_KEY": "your_api_key_here" // find a way to correctly add API KEY (already set in zsh)
            }
        }
    ]
}